{
  "name": "geo-kurdistan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Geo-Kurdistan NestJS modular monolith",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:revert": "tsx src/database/revert.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:prod": "node dist/database/seed.js",
    "db:seed:catalog": "tsx src/database/seed-curated-scientific-catalog.ts",
    "db:seed:catalog:prod": "node dist/database/seed-curated-scientific-catalog.js",
    "db:publish:catalog": "tsx src/database/publish-curated-scientific-catalog.ts",
    "db:publish:catalog:prod": "node dist/database/publish-curated-scientific-catalog.js",
    "auth:create-initial-admin": "tsx src/identity/create-initial-admin.ts",
    "auth:create-initial-admin:prod": "node dist/identity/create-initial-admin.js",
    "job:proof": "tsx src/jobs/proof.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:seed:teacher:prod": "node scripts/seed-teacher-content.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "firebase-admin": "^14.5.0",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pg-boss": "^11.1.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.31"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
