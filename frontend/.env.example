# Reference only: Next.js npm commands now preload the repository-root .env.
# Use root .env.example; retire old local files after transferring their settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_CSRF_COOKIE_NAME=gk_csrf
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-public-web-app-id
