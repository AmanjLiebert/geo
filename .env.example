POSTGRES_DB=geo_kurdistan
POSTGRES_USER=geo_kurdistan
POSTGRES_PASSWORD=replace-with-a-long-random-password
COMPOSE_DATABASE_URL=postgresql://geo_kurdistan:replace-with-url-encoded-password@database:5432/geo_kurdistan
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
SWAGGER_ENABLED=false
HEALTH_DB_TIMEOUT_MS=2000
QUEUE_SCHEMA=pgboss
QUEUE_CONCURRENCY=2
JOB_PROOF_TIMEOUT_MS=15000
SITE_ADDRESS=:80

# Firebase Authentication. Keep the service-account JSON outside Git.
AUTH_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
AUTH_SESSION_COOKIE_NAME=gk_session
AUTH_CSRF_COOKIE_NAME=gk_csrf
AUTH_PREAUTH_CSRF_COOKIE_NAME=gk_preauth_csrf
AUTH_SESSION_TTL_SECONDS=86400
AUTH_REAUTH_MAX_AGE_SECONDS=300
AUTH_INVITATION_TTL_HOURS=72
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_PRIVILEGED_MFA_REQUIRED=false

# Separate private primary-media bucket. Never reuse the recovery/backup bucket.
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_REGION=us-west-004
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_KEY_ID=
MEDIA_STORAGE_APPLICATION_KEY=
MEDIA_SCANNER_HOST=clamav
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_TIMEOUT_MS=120000
MEDIA_MAX_PDF_PAGES=100

# Public Firebase web configuration embedded into the static frontend build.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CSRF_COOKIE_NAME=gk_csrf
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-public-web-app-id

# Initial container limits; tune from measured usage and total server capacity.
DATABASE_MEMORY_LIMIT=2g
DATABASE_CPU_LIMIT=2.0
MIGRATION_MEMORY_LIMIT=512m
MIGRATION_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=512m
WORKER_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=256m
PROXY_CPU_LIMIT=0.5

# Off-server encrypted backup configuration used by ops/scripts/backup-postgres.sh.
RESTIC_REPOSITORY=s3:https://object-storage.example/geo-kurdistan-backups
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
